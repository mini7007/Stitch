# ── Database (Neon PostgreSQL) ────────────────────────────────────────────
DATABASE_URL="postgresql://<user>:<password>@<host>/<dbname>?sslmode=require"

# ── NextAuth ──────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32   (or any long random string)
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Google OAuth (optional — leave blank to hide Google sign-in) ──────────
# Setup steps in README.md → "Sign in with Google"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Required for choosing ADMIN in the Google sign-in role picker
ADMIN_INVITE_CODE="stitch-admin"

# ── Payments ──────────────────────────────────────────────────────────────
# "demo" (default): mock UPI QR + "Simulate Payment Success" button.
# "live": Razorpay — mock route 403s; see README → "Real payments".
NEXT_PUBLIC_PAYMENT_MODE="demo"
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# ── S3-compatible storage (optional) ──────────────────────────────────────
AWS_ENDPOINT_URL_S3=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION=""
